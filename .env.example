# ============================================================
# Dashboard trading (forex) — Variables d'environnement
# ============================================================
# Copiez ce fichier vers .env et renseignez vos valeurs :
#   cp .env.example .env
#
# Le projet ne contient que le module forex (paper trading).
# ============================================================

# --- Notifications Telegram ---
# Token du bot Telegram et ID du chat (laisser vide pour désactiver)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO

# --- API Macroéconomiques (optionnel) ---
# Requis uniquement par le bot macro_trend (différentiel de taux directeurs).
# Sans clé, get_pair_macro_bias() renvoie toujours 0.0 : le bot ne bloque
# jamais rien, il n'entre simplement jamais (biais toujours "insuffisant").
# Clé gratuite : https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ============================================================
#  MODULE FOREX multi-signaux — voir README
# ============================================================
# AUCUN secret requis : les prix viennent d'un feed public (yfinance) et
# l'exécution est 100 % simulée (paper trading).

# Univers (chaque paire = 1 requête yfinance de plus par cycle), granularité
# (M1,M5,M15,H1,H4,D), devise du compte simulé
FOREX_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP,EUR_JPY,GBP_JPY
FOREX_DATA_SOURCE=yfinance
FOREX_GRANULARITY=H1
FOREX_ACCOUNT_CCY=EUR

# Activation indépendante de chaque famille de signal (pour mesurer sa
# contribution marginale). true/false.
FOREX_USE_TECHNICAL=true
FOREX_USE_FUNDAMENTAL=true
FOREX_USE_TIME_FILTER=true

# Mode de la règle de confluence :
#   any    = entre dès qu'un signal actif tire → DES TRADES TOUT DE SUITE
#            (le technique tire immédiatement ; le fondamental s'ajoute quand
#            l'historique du calendrier est suffisant). Recommandé pour démarrer.
#   strict = n'entre qu'en vraie confluence (tous les signaux actifs d'accord),
#            très sélectif — objectif une fois l'edge validé.
# (Le rapport de validation force toujours "strict" quel que soit ce réglage.)
FOREX_CONFLUENCE_MODE=any

# Signal fondamental (surprise score macro)
FOREX_SURPRISE_THRESHOLD=0.5
FOREX_MIN_SURPRISE_HISTORY=8

# Signal technique
FOREX_RSI_PERIOD=14
FOREX_RSI_OVERBOUGHT=70
FOREX_RSI_OVERSOLD=30
FOREX_MACD_FAST=12
FOREX_MACD_SLOW=26
FOREX_MACD_SIGNAL=9
FOREX_MA_FAST=50
FOREX_MA_SLOW=200

# Bot croisement de moyennes mobiles.
FOREX_MA_CROSSOVER_FAST=20
FOREX_MA_CROSSOVER_SLOW=100

# Bot cassure de canal : fenêtre du plus haut/bas glissant, en bougies.
FOREX_CHANNEL_BREAKOUT_BARS=20

# Bot cassure Londres : fenêtre d'entrée après l'ouverture, en heures.
FOREX_LONDON_BREAKOUT_WINDOW_HOURS=4

# Filtre temporel (minutes autour des annonces high-impact)
FOREX_EXCLUSION_MIN_BEFORE=15
FOREX_EXCLUSION_MIN_AFTER=5
# Sortie forcée d'un trade EVENT-DRIVEN (déclenché par une surprise macro) qui
# n'a pas bougé après N minutes. Ne concerne PAS les trades techniques.
FOREX_EVENT_TRADE_MAX_MIN=120
FOREX_POST_EVENT_SPREAD_MULT=5.0
# Détention absolue maximale (en barres, tous trades) — filet de sécurité.
FOREX_MAX_HOLD_BARS=200

# Risque
FOREX_RISK_PCT=1.0
FOREX_DAILY_LOSS_LIMIT_PCT=3.0
FOREX_WEEKLY_LOSS_LIMIT_PCT=6.0
FOREX_TRAILING_DD_PCT=10.0
FOREX_ATR_PERIOD=14
FOREX_ATR_STOP_MULT=2.0
FOREX_ATR_TP_MULT=3.0

# Coûts réalistes (backtest & paper), en pips
FOREX_SPREAD_PIPS=0.8
FOREX_SLIPPAGE_PIPS=0.3
FOREX_SWAP_PIPS_PER_DAY=0.2
FOREX_COMMISSION_PIPS=0.6

# Paper trading (capital simulé de départ, cadence de polling)
FOREX_START_EQUITY=10000
FOREX_POLL_SECONDS=60

# Bot TSM (momentum) : fenêtre du rendement cumulé, en bougies.
FOREX_TSM_LOOKBACK_BARS=500

# Apprentissage (module 7) — garde-fous anti-overfitting
FOREX_LEARN_MIN_SAMPLE=15
FOREX_LEARN_TRADE_PALIER=30
FOREX_LEARN_ALPHA=0.05
FOREX_LEARN_MIN_FOLDS=3
FOREX_LEARN_POSITIVE_FOLD_RATIO=0.6
FOREX_LEARN_OOS_MARGIN_PCT=1.0
